[
  {
    "key": "web-mobile-unify-engage",
    "name": "Web + Mobile → Unify → Engage",
    "description": "The canonical full-stack architecture: browser and app sources into Connections, profiles in Unify, audiences and a journey in Engage. Start here for most customers.",
    "category": "Reference architecture",
    "sort_order": 0,
    "nodes": [
      {
        "id": "ph:source-web",
        "kind": "source",
        "name": "Marketing site",
        "sourceType": "javascript",
        "description": "Analytics.js on the marketing site and web app. Usually the highest-volume source and the one that defines the event taxonomy.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "javascript"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-ios",
        "kind": "source",
        "name": "iOS app",
        "sourceType": "ios",
        "description": "Analytics-Swift. Shares the event names with the web source — if it does not, that gap is worth drawing attention to here.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "ios",
            "apple",
            "swift"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-android",
        "kind": "source",
        "name": "Android app",
        "sourceType": "android",
        "description": "Analytics-Kotlin.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "android",
            "kotlin"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-backend",
        "kind": "source",
        "name": "Backend service",
        "sourceType": "server",
        "description": "Server-side events: purchases, refunds, subscription changes. The events you cannot trust a client to send.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "node",
            "python",
            "java",
            "go",
            "ruby",
            "php",
            "http",
            "http-api"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-insert-fn",
        "kind": "source_insert_function",
        "name": "Enrich + redact",
        "description": "Runs before the event reaches Segment: drop PII the client should not have sent, and add anything only the server knows.",
        "binds": {
          "kind": "source_insert_function"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:filter-eu",
        "kind": "destination_filter",
        "name": "Consent filter",
        "description": "Drops events for profiles that have not consented to marketing before they reach the ad and email destinations. An event arriving without `context.consent.marketing` set is treated as not consented, which is what makes the drop visible in a walkthrough.",
        "condition": "!context.consent.marketing",
        "actions": [
          {
            "type": "DROP"
          }
        ],
        "binds": {
          "kind": "destination_filter"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:dest-analytics",
        "kind": "destination",
        "name": "Product analytics",
        "description": "Amplitude, Mixpanel, or similar. Gets the full event stream.",
        "binds": {
          "kind": "destination",
          "categories": [
            "Analytics",
            "Raw Data"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:dest-engagement",
        "kind": "destination",
        "name": "Email / push",
        "description": "Braze, Iterable, Customer.io. Downstream of the consent filter.",
        "binds": {
          "kind": "destination",
          "categories": [
            "Email Marketing",
            "Marketing Automation",
            "CRM"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:dest-ads",
        "kind": "destination",
        "name": "Paid media",
        "description": "Audience sync for ad platforms. Fed from Engage rather than from the raw stream, so the ad account only ever sees the segment.",
        "binds": {
          "kind": "destination",
          "categories": [
            "Advertising",
            "Google",
            "Facebook"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:warehouse",
        "kind": "warehouse",
        "name": "Warehouse",
        "description": "The full event history, for analysis Segment is not the right tool for. Also the join key back to non-Segment data.",
        "binds": {
          "kind": "warehouse"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:space",
        "kind": "space",
        "name": "Unify space",
        "description": "Where events become profiles. Everything in Engage reads from here.",
        "binds": {
          "kind": "space"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "idres",
        "kind": "identity_resolution",
        "name": "Identity resolution",
        "synthetic": true,
        "bound": true,
        "description": "Match rules and identifier precedence. Configured per space in Segment — this node is a reminder to check them, not a resource this tool reads.",
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:trait-ltv",
        "kind": "computed_trait",
        "name": "Lifetime value",
        "description": "An aggregation trait over purchase events. The example of a trait that only exists because the backend source is wired up.",
        "binds": {
          "kind": "computed_trait"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:trait-engagement",
        "kind": "computed_trait",
        "name": "Last seen",
        "description": "A most-recent trait. Cheap, and the one most audiences end up depending on.",
        "binds": {
          "kind": "computed_trait"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "profile-api",
        "kind": "profile_api",
        "name": "Profile API",
        "synthetic": true,
        "bound": true,
        "description": "Read surface over the space: the customer's own services asking \"what do we know about this user?\" at request time.",
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:audience-highvalue",
        "kind": "audience",
        "name": "High-value customers",
        "description": "Built on the lifetime-value trait. Syncs to paid media.",
        "binds": {
          "kind": "audience"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:audience-churn",
        "kind": "audience",
        "name": "At risk of churn",
        "description": "Built on the last-seen trait. Entry condition for the win-back journey.",
        "binds": {
          "kind": "audience"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "journey-winback",
        "kind": "journey",
        "name": "Win-back journey",
        "bindable": false,
        "description": "Segment publishes no Journeys API, so this node is drawn by hand and cannot be bound. Edit it to match what is actually configured in Engage.",
        "showFields": {
          "description": false
        }
      }
