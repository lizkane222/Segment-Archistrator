  {
    "key": "end-to-end-test",
    "name": "End-to-end test harness",
    "description": "One source, one transform, one filter, one destination. Deliberately small: this is the diagram to open when you want to watch a single event travel the pipeline and see exactly where it is dropped.",
    "category": "Validation",
    "sort_order": 2,
    "nodes": [
      {
        "id": "ph:source-test",
        "kind": "source",
        "name": "Test source",
        "sourceType": "http",
        "description": "An HTTP API source is the easiest thing to send a deliberate event into — curl, no SDK, no build step.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "http",
            "http-api",
            "javascript"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:insert-fn",
        "kind": "source_insert_function",
        "name": "Transform under test",
        "description": "The step whose behaviour you are actually checking. Simulate an event with and without it to see what it changes.",
        "binds": {
          "kind": "source_insert_function"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:filter-under-test",
        "kind": "destination_filter",
        "name": "Filter under test",
        "description": "The commonest cause of \"the event never arrived\". Bind the real filter and the simulator will report its verdict and its reason. Until you do, it is configured to drop every track call, so this template demonstrates the drop it exists to explain.",
        "condition": "type = \"track\"",
        "actions": [
          {
            "type": "DROP"
          }
        ],
        "binds": {
          "kind": "destination_filter"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:dest-under-test",
        "kind": "destination",
        "name": "Destination under test",
        "description": "Where the event is supposed to end up.",
        "binds": {
          "kind": "destination"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:dest-debug",
        "kind": "destination",
        "name": "Webhook (control)",
        "description": "An unfiltered webhook destination, wired straight off the transform with no filter in between. If the event reaches here and not the destination under test, the filter is the answer.",
        "binds": {
          "kind": "destination",
          "categories": [
            "Webhooks",
            "Raw Data"
          ]
        },
        "showFields": {
          "description": false
        }
      }
    ],
    "edges": [
      {
        "source": "ph:source-test",
        "target": "ph:insert-fn"
      },
      {
        "source": "ph:insert-fn",
        "target": "ph:filter-under-test"
      },
      {
        "source": "ph:insert-fn",
        "target": "ph:dest-debug"
      },
      {
        "source": "ph:filter-under-test",
        "target": "ph:dest-under-test"
      }
    ]
  },
  {
    "key": "mtu-billing-view",
    "name": "MTU / billing view",
    "description": "Sources and the space only, annotated with what each contributes to billing. MTU is counted across all sources at once, on distinct users seen per month — not per source, and not per destination, which is why there is no destination detail here. Leaving it out is what makes this view readable in a commercial conversation.",
    "category": "Commercial",
    "sort_order": 3,
    "nodes": [
      {
        "id": "ph:source-web",
        "kind": "source",
        "name": "Website",
        "sourceType": "javascript",
        "description": "MTU: anonymous visitors do not count until they are identified. A high anonymous-to-identified ratio here is the usual first thing to look at.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "javascript"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-mobile",
        "kind": "source",
        "name": "Mobile apps",
        "sourceType": "ios",
        "description": "MTU: logged-in app users are almost always counted. Typically the densest contributor per user.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "ios",
            "android"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-server",
        "kind": "source",
        "name": "Backend",
        "sourceType": "server",
        "description": "MTU: server events carry a userId by definition, so every distinct user reached this month counts. Watch for batch jobs that touch the whole user table — that is the classic surprise on an invoice.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "node",
            "python",
            "java",
            "go",
            "http"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-cloud",
        "kind": "source",
        "name": "Cloud sources",
        "sourceType": "salesforce",
        "description": "MTU: a scheduled sync that touches every record counts every record. The most common cause of an MTU number nobody can explain.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "salesforce",
            "hubspot",
            "stripe"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:space",
        "kind": "space",
        "name": "Unify space",
        "description": "Profiles, which is the unit the MTU count is really about. Bind this and the inspector shows the space's real profile count.",
        "binds": {
          "kind": "space"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:warehouse",
        "kind": "warehouse",
        "name": "Warehouse",
        "description": "Included because it is the place to actually verify an MTU figure: count distinct userId per month in the identifies and tracks tables.",
        "binds": {
          "kind": "warehouse"
        },
        "showFields": {
          "description": false
        }
      }
    ],
    "edges": [
      {
        "source": "ph:source-web",
        "target": "ph:space"
      },
      {
