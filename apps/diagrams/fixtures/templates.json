  {
    "key": "cloud-sources-reverse-etl",
    "name": "Cloud sources + Reverse ETL",
    "description": "Warehouse-first. Cloud sources pull business systems into Segment and the warehouse, then Reverse ETL models push modelled data back out to the tools that act on it.",
    "category": "Reference architecture",
    "sort_order": 1,
    "nodes": [
      {
        "id": "ph:source-crm",
        "kind": "source",
        "name": "CRM (cloud source)",
        "sourceType": "salesforce",
        "description": "A cloud source is a scheduled pull, not a stream — object records arrive as identify/group calls on Segment's sync cadence, not in real time.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "salesforce",
            "hubspot",
            "dynamics-365"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-billing",
        "kind": "source",
        "name": "Billing (cloud source)",
        "sourceType": "stripe",
        "description": "Subscriptions, invoices, failed payments — the events that make a revenue model possible.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "stripe",
            "recurly",
            "chargebee",
            "zuora"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-app",
        "kind": "source",
        "name": "Product events",
        "sourceType": "javascript",
        "description": "Behavioural events, so the warehouse can join product usage to billing.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "javascript",
            "node",
            "http"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:warehouse",
        "kind": "warehouse",
        "name": "Warehouse",
        "description": "The centre of this architecture rather than a side-effect of it. Reverse ETL models are SQL against this.",
        "binds": {
          "kind": "warehouse"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:retl-accounts",
        "kind": "reverse_etl_model",
        "name": "Account health model",
        "description": "SQL joining product usage to billing state. Runs on a schedule; its output is what the CRM actually sees.",
        "binds": {
          "kind": "reverse_etl_model"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:retl-leads",
        "kind": "reverse_etl_model",
        "name": "Lead scoring model",
        "description": "The second model, drawn separately because the two have different schedules and different failure modes.",
        "binds": {
          "kind": "reverse_etl_model"
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:dest-crm",
        "kind": "destination",
        "name": "CRM (write-back)",
        "description": "The same system that appears as a cloud source on the left. Data going both ways is the thing this diagram exists to make visible.",
        "binds": {
          "kind": "destination",
          "categories": [
            "CRM"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:dest-support",
        "kind": "destination",
        "name": "Support tool",
        "description": "Account health on the ticket, so support sees it without leaving the tool.",
        "binds": {
          "kind": "destination",
          "categories": [
            "CRM",
            "Customer Success",
            "Analytics"
          ]
        },
        "showFields": {
          "description": false
