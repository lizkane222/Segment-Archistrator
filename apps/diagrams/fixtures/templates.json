  {
    "key": "mtu-billing-view",
    "name": "MTU / billing view",
    "description": "Sources and the space only, annotated with what each contributes to billing. MTU is counted across all sources at once, on distinct users seen per month \u2014 not per source, and not per destination, which is why there is no destination detail here. Leaving it out is what makes this view readable in a commercial conversation.",
    "category": "Commercial",
    "sort_order": 4,
    "nodes": [
      {
        "id": "ph:source-web",
        "kind": "source",
        "name": "Website",
        "sourceType": "javascript",
        "description": "MTU: anonymous visitors do not count until they are identified. A high anonymous-to-identified ratio here is the usual first thing to look at.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "javascript"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-mobile",
