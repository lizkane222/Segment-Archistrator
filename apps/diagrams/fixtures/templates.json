        "description": "MTU: logged-in app users are almost always counted. Typically the densest contributor per user.",
        "binds": {
          "kind": "source",
          "sourceType": [
            "ios",
            "android"
          ]
        },
        "showFields": {
          "description": false
        }
      },
      {
        "id": "ph:source-server",
        "kind": "source",
        "name": "Backend",
        "sourceType": "server",
        "description": "MTU: server events carry a userId by definition, so every distinct user reached this month counts. Watch for batch jobs that touch the whole user table \u2014 that is the classic surprise on an invoice.",
