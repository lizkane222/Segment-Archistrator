# Mirrors the migrate / seed_templates / sync_catalog steps in render.yaml's
# buildCommand. Those can't run in CodeBuild (no access to the real
# DATABASE_URL there), so they run here, once per deploy, against the actual
# RDS instance.
#
# leader_only makes this run on exactly one instance even if the environment
# has more than one -- required once this scales past a single instance, so
# migrations don't race.
container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_seed_templates:
    command: "source /var/app/venv/*/bin/activate && python manage.py seed_templates"
    leader_only: true
  03_sync_catalog:
    command: "source /var/app/venv/*/bin/activate && python manage.py sync_catalog || echo 'sync_catalog skipped'"
    leader_only: true
