# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches the docker run in README)
DATABASE_URL=postgres://postgres:dev@localhost:5432/segarch

# Comma-separated Fernet keys, NEWEST FIRST. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEGMENT_TOKEN_ENCRYPTION_KEYS=

# Session lifetime for a pasted Public API token, in hours
WORKSPACE_SESSION_IDLE_HOURS=12

# Token used ONLY by `manage.py sync_catalog` to read the global Segment catalog.
# Not a customer token and never used for customer data. If unset, sync_catalog
# borrows the most recent session's token, which is fine locally but not on a
# server where no one has logged in yet.
SEGMENT_CATALOG_TOKEN=
SEGMENT_CATALOG_REGION=us
