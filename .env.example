# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches the docker run in README)
DATABASE_URL=postgres://postgres:dev@localhost:5432/segarch

# Comma-separated Fernet keys, NEWEST FIRST. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEGMENT_TOKEN_ENCRYPTION_KEYS=

# Session lifetime for a pasted Public API token, in hours
WORKSPACE_SESSION_IDLE_HOURS=12

# Token used ONLY by `manage.py sync_catalog` to read the global Segment catalog.
# Not a customer token and never used for customer data. If unset, sync_catalog
# borrows the most recent session's token, which is fine locally but not on a
# server where no one has logged in yet.
SEGMENT_CATALOG_TOKEN=
SEGMENT_CATALOG_REGION=us

# --- Airtable: the feedback form -------------------------------------------
# A personal access token with `data.records:write` and `schema.bases:read`.
# Server-side only -- the form posts to this app, which then calls Airtable. A
# write-scoped token in a frontend bundle is one anyone can use.
#   https://airtable.com/create/tokens
AIRTABLE_API_KEY=
# Both discoverable once the token is set:
#   python manage.py airtable_schema
# AIRTABLE_TABLE takes a name or a table id, and an id (`tbl...`) is the better
# choice: renaming the table in Airtable then does not break submissions.
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

# --- Accounts: Google sign-in ----------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# and add this exact URL as an Authorized redirect URI:
#   http://localhost:8010/api/auth/google/callback
# Leave both unset and sign-in simply does not appear -- anonymous use still works.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Normally derived from the request, so one setting covers localhost and production.
# Pin it only when a proxy makes the request's own scheme or host wrong; it must match
# the Google console entry byte for byte.
GOOGLE_OAUTH_REDIRECT_URI=

# Who may sign in without an invitation, comma-separated and matched exactly
# (example.com does NOT admit mail.example.com). Empty means invitation-only, in which
# case admit the first person with:
#   python manage.py invite_user --email you@example.com
ALLOWED_EMAIL_DOMAINS=
